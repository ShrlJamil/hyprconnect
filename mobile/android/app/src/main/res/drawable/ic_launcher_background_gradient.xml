<?xml version="1.0" encoding="utf-8"?>
<!-- The logo gradient, top #00FFDB to bottom #008EFB.  It sits in
     the adaptive icon's background layer; the foreground is an
     indigo plate with the mark knocked out, so the mark itself is
     this gradient showing through the stencil. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#00FFDB"
        android:endColor="#008EFB" />
</shape>
